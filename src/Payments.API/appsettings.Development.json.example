{
  "ConnectionStrings": {
    "Payments": "Host=<rds-fcg-dev-payments-endpoint>;Port=5432;Database=payments_db;Username=postgres;Password="
  },
  "Jwt": {
    "RsaPublicKey": "<base64 do PEM da chave pública — mesma chave publicada pela UsersAPI (JWKS)>",
    "Issuer": "FiapCloudGames",
    "Audience": "FiapCloudGames"
  },
  "AWS": {
    "Region": "us-east-1"
  },
  "Messaging": {
    "Scope": "fcg-dev"
  }
}
